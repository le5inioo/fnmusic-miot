#!/bin/bash
# Shared helpers for fnmusic-miot App Center lifecycle scripts (sourced, not run).
# 原生部署版：不再依赖 Docker，运行期由 systemd 单元 fnmusic-miot.service 承载。
# The sourcing script must set SELF_DIR to its own directory first.

FNMUSIC_MIOT_APP_ROOT="$(cd "${SELF_DIR}/.." && pwd)"
# cmd/ lives at <app>/cmd；仓库主体落在 <app>/repo。以 nodeconsole/server.mjs 作存在标记。
MIOT_REPO_DIR=""
for _cand in "${TRIM_APPDEST:-}/repo" "${FNMUSIC_MIOT_APP_ROOT}/target/repo" "${FNMUSIC_MIOT_APP_ROOT}/repo"; do
    if [ -n "${_cand}" ] && [ -f "${_cand}/nodeconsole/server.mjs" ]; then
        MIOT_REPO_DIR="$(cd "${_cand}" && pwd)"
        break
    fi
done
unset _cand

# 应用目录必须是「已安装位置」。
# 安装/升级期间脚本从临时解包目录（如 /vol1/appcenter-downloads/xxx-tpk）执行，
# 那时 SELF_DIR/.. 是临时目录，用它推 appdir 会把 socket 建到临时目录里。
# repo 探测带存在标记（nodeconsole/server.mjs），指向的才是真实安装目录，取其父目录。
if [ -n "${MIOT_REPO_DIR}" ]; then
    MIOT_APPDIR="$(dirname "${MIOT_REPO_DIR}")"
else
    MIOT_APPDIR="${FNMUSIC_MIOT_APP_ROOT}"
fi
MIOT_UNIT_NAME="fnmusic-miot.service"
MIOT_UNIT_PATH="/etc/systemd/system/${MIOT_UNIT_NAME}"
MIOT_SOCKET="${MIOT_APPDIR}/fnmusic-miot.sock"
# 运行期数据（token / storage.json / 日志）必须放在升级不会覆盖的位置。
# repo/ 在升级时会被新包整体替换，所以数据落 appdata/var 而不是 repo/miot-data。
MIOT_DATA_ROOT="${TRIM_PKGVAR:-/vol1/@appdata/fnmusic-miot}/var"
MIOT_LOG_DIR="${MIOT_DATA_ROOT}/logs"
FNMUSIC_MIOT_LOG="${TRIM_PKGVAR:-/tmp}/fnmusic-miot.log"
mkdir -p "$(dirname "${FNMUSIC_MIOT_LOG}")" 2>/dev/null || true

# 应用中心安装失败会回滚删除 TRIM_PKGVAR，fnmusic-miot.log 会一起消失。
# 过程输出同时追加到这份不随回滚删除的日志。
if [ -z "${FNMUSIC_MIOT_DURABLE_LOG:-}" ]; then
    FNMUSIC_MIOT_DURABLE_LOG="/var/log/apps/fnmusic-miot-install.log"
    if ! { mkdir -p /var/log/apps && touch "${FNMUSIC_MIOT_DURABLE_LOG}"; } 2>/dev/null; then
        FNMUSIC_MIOT_DURABLE_LOG="/tmp/fnmusic-miot-install.log"
    fi
fi
mkdir -p "$(dirname "${FNMUSIC_MIOT_DURABLE_LOG}")" 2>/dev/null || true
touch "${FNMUSIC_MIOT_DURABLE_LOG}" 2>/dev/null || true
chmod a+r "${FNMUSIC_MIOT_DURABLE_LOG}" 2>/dev/null || true

fnmusic_miot_fail() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "$1" > "${TRIM_TEMP_LOGFILE}" || true
    fi
    echo "[fnmusic-miot] $1" >&2
    exit 1
}

fnmusic_miot_error_brief() {
    local log="${1:-${FNMUSIC_MIOT_LOG}}"
    [ -f "${log}" ] || return 0
    sed $'s/\x1b\\[[0-9;]*m//g' "${log}" 2>/dev/null \
        | grep -aE '\[ERROR\]|ERROR:|(^|[^A-Za-z])E: ' \
        | tail -n 5 \
        | tr '\n' ' ' \
        | cut -c1-400
}

fnmusic_miot_log_tail_brief() {
    local log="${1:-${FNMUSIC_MIOT_LOG}}"
    [ -f "${log}" ] || return 0
    sed $'s/\x1b\\[[0-9;]*m//g' "${log}" 2>/dev/null \
        | tail -n 5 \
        | tr '\n' ' ' \
        | cut -c1-300
}

fnmusic_miot_run_logged() {
    local stamp rc pipefail_on=0
    stamp="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo unknown-time)"
    printf '\n===== %s %s =====\n' "${stamp}" "$*" >> "${FNMUSIC_MIOT_DURABLE_LOG}" 2>/dev/null || true
    if set -o | grep -q 'pipefail[[:space:]]*on'; then
        pipefail_on=1
    fi
    set +o pipefail
    "$@" 2>&1 | tee -a "${FNMUSIC_MIOT_DURABLE_LOG}" >> "${FNMUSIC_MIOT_LOG}"
    rc=${PIPESTATUS[0]}
    if [ "${pipefail_on}" -eq 1 ]; then
        set -o pipefail
    fi
    return "${rc}"
}

fnmusic_miot_fail_from_log() {
    local prefix="$1" err_brief
    err_brief="$(fnmusic_miot_error_brief)"
    if [ -z "${err_brief}" ]; then
        err_brief="$(fnmusic_miot_log_tail_brief)"
    fi
    tail -n 5 "${FNMUSIC_MIOT_LOG}" >&2 || true
    fnmusic_miot_fail "${prefix}。日志：${FNMUSIC_MIOT_DURABLE_LOG}。${err_brief:-未捕获到错误行}"
}

# ------------------------------------------------------------------------------
# Node 运行时探测。
# 优先 .env 里已固定的路径（安装时写入），否则按应用商店 Node.js 的常见落点探测，
# 最后才退回 PATH 里的 node。返回绝对路径；找不到返回空串。
# ------------------------------------------------------------------------------
fnmusic_miot_env_get() {
    local key="$1" file="${MIOT_REPO_DIR}/.env"
    [ -f "${file}" ] || return 0
    grep -E "^[[:space:]]*(export[[:space:]]+)?${key}=" "${file}" 2>/dev/null \
        | tail -n1 | cut -d= -f2- \
        | sed -e "s/^['\"]//" -e "s/['\"]$//" -e 's/[[:space:]]*$//'
}

fnmusic_miot_find_node() {
    local cand base found

    cand="$(fnmusic_miot_env_get FNMUSIC_MIOT_NODE_BIN)"
    if [ -n "${cand}" ] && [ -x "${cand}" ]; then
        echo "${cand}"; return 0
    fi

    for cand in \
        /vol1/@appcenter/nodejs_v22/bin/node \
        /vol1/@appcenter/nodejs_v20/bin/node \
        /vol1/@appcenter/nodejs_v18/bin/node \
        /vol1/@appcenter/nodejs/bin/node \
        /vol1/@appcenter/nodejs/target/bin/node \
        /usr/local/apps/@appcenter/nodejs_v22/bin/node \
        /usr/local/apps/@appcenter/nodejs/bin/node \
        /usr/local/bin/node \
        /usr/bin/node; do
        if [ -x "${cand}" ]; then echo "${cand}"; return 0; fi
    done

    # 应用商店 Node.js 可能装在别处（多卷、带版本号目录）：先找 node* 命名的应用目录，
    # 再在其中按有限深度找可执行的 node。刻意限制 maxdepth，避免扫全盘。
    for base in /vol*/@appcenter /usr/local/apps/@appcenter; do
        [ -d "${base}" ] || continue
        for cand in "${base}"/node* "${base}"/*/nodejs; do
            [ -d "${cand}" ] || continue
            found="$(find "${cand}" -maxdepth 4 -type f -name node -perm -u+x 2>/dev/null | head -n1)"
            if [ -n "${found}" ]; then echo "${found}"; return 0; fi
        done
    done

    cand="$(command -v node 2>/dev/null || true)"
    if [ -n "${cand}" ] && [ -x "${cand}" ]; then echo "${cand}"; return 0; fi

    echo ""
}

# 主版本须 >= 18（用到 node: 前缀 ESM、AbortController、structuredClone、closeAllConnections）。
fnmusic_miot_node_major() {
    local bin="$1" ver
    [ -x "${bin}" ] || { echo 0; return 0; }
    ver="$("${bin}" -v 2>/dev/null | sed -n 's/^v\([0-9]\+\).*/\1/p')"
    echo "${ver:-0}"
}

# ------------------------------------------------------------------------------
# systemd 单元安装/移除
# ------------------------------------------------------------------------------
fnmusic_miot_write_unit() {
    local node_bin="$1" tpl="${SELF_DIR}/fnmusic-miot.service.in" tmp
    [ -f "${tpl}" ] || return 1
    [ -n "${MIOT_REPO_DIR}" ] || return 1
    tmp="$(mktemp 2>/dev/null || echo /tmp/fnmusic-miot.unit.$$)"
    sed -e "s#@REPO@#${MIOT_REPO_DIR}#g" -e "s#@NODE@#${node_bin}#g" "${tpl}" > "${tmp}" || return 1
    install -m 0644 "${tmp}" "${MIOT_UNIT_PATH}" || { rm -f "${tmp}"; return 1; }
    rm -f "${tmp}"
    systemctl daemon-reload >/dev/null 2>&1 || true
    return 0
}

fnmusic_miot_remove_unit() {
    systemctl disable --now "${MIOT_UNIT_NAME}" >/dev/null 2>&1 || true
    systemctl stop "${MIOT_UNIT_NAME}" >/dev/null 2>&1 || true
    rm -f "${MIOT_UNIT_PATH}" 2>/dev/null || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    rm -f "${MIOT_SOCKET}" 2>/dev/null || true
}

fnmusic_miot_unit_active() {
    systemctl is-active --quiet "${MIOT_UNIT_NAME}" 2>/dev/null
}

# ------------------------------------------------------------------------------
# 端口：8775 / 8776 只是首次安装的默认值，.env 才是唯一数据源。
# 用户在 .env 里改 MIOT_PORT / FNMUSIC_MIOT_CONSOLE_PORT 后，安装、升级、
# 探活与诊断都按实际值工作，不会被覆盖回默认值。
# ------------------------------------------------------------------------------
MIOT_DEFAULT_PORT="8775"
MIOT_DEFAULT_CONSOLE_PORT="8776"

# 服务端口引导功能自该版本起引入；从该版本之前的版本升级时，安装/升级脚本会写入
# 「待设置」标记，让面板首次打开直接跳到「设置 → 服务端口」。空旧版本按「老版本」处理。
MIOT_PORT_GUIDE_SINCE="2.3.4"

# 语义化版本比较：传入「旧版本」与「起始版本」，旧 < 起始 时返回 0（真）。
# 空旧版本视为「尚无此功能」，当作旧版处理。
fnmusic_miot_version_lt() {
  [ -z "$1" ] && return 0
  local a="$1" b="${2:-${MIOT_PORT_GUIDE_SINCE}}" IFS='.'
  local a1 a2 a3 b1 b2 b3 rest
  a1="${a%%.*}"; rest="${a#*.}"; a2="${rest%%.*}"; a3="${rest#*.}"
  b1="${b%%.*}"; rest="${b#*.}"; b2="${rest%%.*}"; b3="${rest#*.}"
  [ "${a1:-0}" -lt "${b1:-0}" ] && return 0
  [ "${a1:-0}" -gt "${b1:-0}" ] && return 1
  [ "${a2:-0}" -lt "${b2:-0}" ] && return 0
  [ "${a2:-0}" -gt "${b2:-0}" ] && return 1
  [ "${a3:-0}" -lt "${b3:-0}" ] && return 0
  return 1
}

# 把当前版本号持久化到数据根，供下次升级判断「是否从老版本升级」。
fnmusic_miot_record_version() {
  local v=""
  [ -n "${MIOT_REPO_DIR}" ] && v="$(cat "${MIOT_REPO_DIR}/VERSION" 2>/dev/null | tr -d '[:space:]')"
  [ -n "${v}" ] || return 0
  mkdir -p "${MIOT_DATA_ROOT}" 2>/dev/null || true
  echo "${v}" > "${MIOT_DATA_ROOT}/VERSION" 2>/dev/null || true
}

# 写入首次安装 / 老版本升级的端口引导标记。前端启动后读到 pending 会直接跳到
# 「设置 → 服务端口」。reason: fresh-install | upgrade；from_version 为旧版本号。
fnmusic_miot_write_port_guide_pending() {
  local reason="${1:-fresh-install}" from="${2:-}"
  mkdir -p "${MIOT_DATA_ROOT}" 2>/dev/null || true
  cat > "${MIOT_DATA_ROOT}/port_setup_state.json" <<EOF
{
  "pending": true,
  "reason": "${reason}",
  "from_version": "${from}",
  "created_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
}
EOF
}

# 仅在「即将使用默认端口且默认端口被其他程序占用」时，调用 runtime/pick_ports.mjs
# 自动挑选两个空闲端口；返回 "控制层 控制台"（空格分隔），无占用返回空串。
# 升级场景（.env 已带自定义端口）不会走到这里，因为那时不会选中默认端口。
fnmusic_miot_pick_if_occupied() {
  local node_bin="${1:-$(fnmusic_miot_find_node)}"
  local owner1 owner2 picked
  owner1="$(fnmusic_miot_port_owner "${MIOT_DEFAULT_PORT}")"
  owner2="$(fnmusic_miot_port_owner "${MIOT_DEFAULT_CONSOLE_PORT}")"
  if [ -z "${owner1}" ] && [ -z "${owner2}" ]; then
    return 0
  fi
  echo "[fnmusic-miot] 默认端口被占用（控制层: ${owner1:-无}, 控制台: ${owner2:-无}），尝试自动挑选可用端口" >> "${FNMUSIC_MIOT_LOG}" 2>&1
  if [ -z "${node_bin}" ] || [ ! -x "${node_bin}" ]; then
    echo "[fnmusic-miot] 未找到可用的 node，无法自动选端口，仍用默认值" >> "${FNMUSIC_MIOT_LOG}" 2>&1
    return 0
  fi
  picked="$(cd "${MIOT_REPO_DIR}" && "${node_bin}" runtime/pick_ports.mjs 2>>"${FNMUSIC_MIOT_LOG}")"
  if [ -n "${picked}" ]; then
    echo "${picked}"
  fi
}

fnmusic_miot_valid_port() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "${1}" -ge 1024 ] && [ "${1}" -le 65535 ]
}

fnmusic_miot_control_port() {
    local p; p="$(fnmusic_miot_env_get MIOT_PORT)"
    if fnmusic_miot_valid_port "${p}"; then echo "${p}"; else echo "${MIOT_DEFAULT_PORT}"; fi
}

fnmusic_miot_console_port() {
    local p; p="$(fnmusic_miot_env_get FNMUSIC_MIOT_CONSOLE_PORT)"
    if fnmusic_miot_valid_port "${p}"; then echo "${p}"; else echo "${MIOT_DEFAULT_CONSOLE_PORT}"; fi
}

# 列出监听该端口的进程 pid（可能多个）。
fnmusic_miot_port_pids() {
    local port="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -ltnp 2>/dev/null | grep -E "[:.]${port}[[:space:]]" \
            | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u
    elif command -v fuser >/dev/null 2>&1; then
        fuser -n tcp "${port}" 2>/dev/null | tr -s ' ' '\n' \
            | grep -E '^[0-9]+$' | sort -u
    fi
}

# 端口被谁占着：返回 "进程名 (pid N)"，未被占用返回空串。
fnmusic_miot_port_owner() {
    local pid comm out="" p
    for pid in $(fnmusic_miot_port_pids "$1"); do
        comm="$(cat "/proc/${pid}/comm" 2>/dev/null || echo unknown)"
        p="${comm} (pid ${pid})"
        out="${out:+${out}, }${p}"
    done
    echo "${out}"
}

# 安装前端口预检：只有能明确判定「占用者不是本应用」时才阻断，
# 避免在覆盖安装 / 升级（旧实例仍在监听）时误伤。判断不了就只记日志放行。
# 首次安装（.env 尚无端口配置）且被占用的是默认端口时，只告警放行，
# 让 env_setup 自动挑选空闲端口，避免安装直接失败。
fnmusic_miot_check_ports_preinstall() {
    local cp cport pid comm cgroup known=1 fresh=0
    if [ ! -f "${MIOT_REPO_DIR}/.env" ] || ! grep -qE '^[[:space:]]*(export[[:space:]]+)?MIOT_PORT=' "${MIOT_REPO_DIR}/.env"; then
        fresh=1
    fi
    cp="$(fnmusic_miot_control_port)"
    cport="$(fnmusic_miot_console_port)"
    for port in "${cp}" "${cport}"; do
        for pid in $(fnmusic_miot_port_pids "${port}"); do
            cgroup="/proc/${pid}/cgroup"
            if [ ! -r "${cgroup}" ]; then
                known=0
                continue
            fi
            grep -q "${MIOT_UNIT_NAME}" "${cgroup}" 2>/dev/null && continue
            comm="$(cat "/proc/${pid}/comm" 2>/dev/null || echo unknown)"
            if [ "${fresh}" -eq 1 ] && { [ "${port}" = "${MIOT_DEFAULT_PORT}" ] || [ "${port}" = "${MIOT_DEFAULT_CONSOLE_PORT}" ]; }; then
                echo "[fnmusic-miot] 默认端口 ${port} 已被 ${comm} (pid ${pid}) 占用：安装时自动避开" >> "${FNMUSIC_MIOT_LOG}" 2>&1
                continue
            fi
            echo "[fnmusic-miot] 端口 ${port} 已被 ${comm} (pid ${pid}) 占用" >> "${FNMUSIC_MIOT_LOG}" 2>&1
            fnmusic_miot_fail "端口 ${port} 已被 ${comm} (pid ${pid}) 占用：请停用该应用，或在 ${MIOT_REPO_DIR}/.env 中修改 MIOT_PORT / FNMUSIC_MIOT_CONSOLE_PORT 后重新安装。日志：${FNMUSIC_MIOT_DURABLE_LOG}"
        done
    done
    [ "${known}" -eq 1 ] || echo "[fnmusic-miot] 端口占用者 cgroup 不可读，跳过预检（启动失败时仍会给出诊断）" >> "${FNMUSIC_MIOT_LOG}" 2>&1
    echo "[fnmusic-miot] 端口预检通过 (control=${cp}, console=${cport})" >> "${FNMUSIC_MIOT_LOG}" 2>&1
}

# 启动/安装失败时给出可执行的诊断，而不是笼统的「启动超时」。
fnmusic_miot_ports_diagnosis() {
    local cp cport out="" owner
    cp="$(fnmusic_miot_control_port)"
    cport="$(fnmusic_miot_console_port)"
    owner="$(fnmusic_miot_port_owner "${cp}")"
    [ -n "${owner}" ] && out="控制层端口 ${cp} 被 ${owner} 占用；"
    owner="$(fnmusic_miot_port_owner "${cport}")"
    [ -n "${owner}" ] && out="${out}控制台端口 ${cport} 被 ${owner} 占用；"
    if [ -n "${out}" ]; then
        echo "${out}请停用占用方，或修改 ${MIOT_REPO_DIR}/.env 中的 MIOT_PORT / FNMUSIC_MIOT_CONSOLE_PORT 后重试。"
    else
        echo "控制层 ${cp} / 控制台 ${cport} 未就绪且未发现端口占用，请查看日志：${FNMUSIC_MIOT_DURABLE_LOG}"
    fi
}

# 探测单个端口是否已接受连接。有 curl 就做 HTTP 探活，没有就退回裸 TCP 探测。
_miot_port_ready() {
    local port="$1"
    if command -v curl >/dev/null 2>&1; then
        curl -fsS -m 2 "http://127.0.0.1:${port}/health" >/dev/null 2>&1
        return $?
    fi
    (exec 3<>"/dev/tcp/127.0.0.1/${port}") >/dev/null 2>&1
}

# 等控制层与控制台都可用；端口按 .env 实际配置，最多 ${1:-20} 秒。
fnmusic_miot_wait_ready() {
    local seconds="${1:-20}" i=0 cp cport
    cp="$(fnmusic_miot_control_port)"
    cport="$(fnmusic_miot_console_port)"
    while [ "${i}" -lt $((seconds * 2)) ]; do
        if _miot_port_ready "${cport}" && _miot_port_ready "${cp}"; then
            return 0
        fi
        i=$((i + 1))
        sleep 0.5
    done
    return 1
}

# ------------------------------------------------------------------------------
# .env 维护
# 容器版（1.0.0）遗留的键值必须覆盖写：端口与路径语义都变了。
# ------------------------------------------------------------------------------
_miot_env_add() {
    local key="$1" val="$2" file="${MIOT_REPO_DIR}/.env"
    if ! grep -Eq "^[[:space:]]*(export[[:space:]]+)?${key}=" "${file}"; then
        printf '%s=%s\n' "${key}" "${val}" >> "${file}"
    fi
}

_miot_env_set() {
    local key="$1" val="$2" file="${MIOT_REPO_DIR}/.env" tmp
    tmp="$(mktemp 2>/dev/null || echo "${file}.tmp")"
    grep -vE "^[[:space:]]*(export[[:space:]]+)?${key}=" "${file}" > "${tmp}" 2>/dev/null || true
    printf '%s=%s\n' "${key}" "${val}" >> "${tmp}"
    cat "${tmp}" > "${file}"
    rm -f "${tmp}"
}

_miot_env_del() {
    local key="$1" file="${MIOT_REPO_DIR}/.env" tmp
    [ -f "${file}" ] || return 0
    tmp="$(mktemp 2>/dev/null || echo "${file}.tmp")"
    grep -vE "^[[:space:]]*(export[[:space:]]+)?${key}=" "${file}" > "${tmp}" 2>/dev/null || true
    cat "${tmp}" > "${file}"
    rm -f "${tmp}"
}

# 从 fnOS 网关配置里读 HTTP 网关端口。配置文件实际是 JSON
# （{"schema":{"http":{"port":6688},"https":{"port":6689}},...}），老实现用
# sed 找字面 `schema.http.port` 从未命中，端口永远回落 6688；而自定义端口
# （5666 / 51666 / 任意值）的用户就会一直连到不存在的端口。这里同时兼容
# JSON、key=value、ini 三种写法，不预设任何具体端口号。
fnmusic_miot_gateway_port() {
    local conf="${FNMUSIC_GATEWAY_CONF:-/usr/trim/etc/network_gateway_setting.conf}"
    local text="" p=""
    [ -r "${conf}" ] || return 1
    text="$(cat "${conf}" 2>/dev/null)"
    [ -n "${text}" ] || return 1
    # 优先 JSON 里的 schema.http.port（http 段通常排在 https 前）。
    p="$(printf '%s' "${text}" | sed -n 's/.*"http"[^0-9]*\([0-9]\{2,5\}\).*/\1/p' | head -n1)"
    # 兜底：任意含 port 的键 / 文本，取其后第一个 2~5 位数字。
    if [ -z "${p}" ]; then
        p="$(printf '%s\n' "${text}" \
            | grep -oiE '[A-Za-z0-9_.-]*port[A-Za-z0-9_.-]*[^0-9]{0,8}[0-9]{2,5}' \
            | grep -oE '[0-9]{2,5}$' | head -n1)"
    fi
    [ -n "${p}" ] || return 1
    printf '%s' "${p}"
}

# 判断 FNMUSIC_BASE_URL 是否为「安装脚本自动生成」的地址：
# http(s)://<回环或本机 LAN IP>[:端口][/]，无路径 / 查询 / userinfo。
# 用户手填的域名、反向代理、带路径的地址一律返回 false，绝不覆盖。
fnmusic_miot_is_auto_base() {
    local v="${1%/}" ip="$2" rest=""
    [ -n "${v}" ] || return 0
    case "${v}" in *\?*|*\#*|*@*) return 1 ;; esac
    case "${v}" in http://*|https://*) ;; *) return 1 ;; esac
    rest="${v#*://}"
    case "${rest}" in */*) return 1 ;; esac
    case "${rest}" in
        127.0.0.1|127.0.0.1:*|localhost|localhost:*|'[::1]'|'[::1]':*) return 0 ;;
    esac
    if [ -n "${ip}" ]; then
        case "${rest}" in "${ip}"|"${ip}":*) return 0 ;; esac
    fi
    return 1
}

fnmusic_miot_env_setup() {
    local env_file="${MIOT_REPO_DIR}/.env" ip="" port="6688" p="" node_bin=""
    local gw_found=0 gw_conf="" ctrl_port console_port legacy=0 cur
    [ -f "${env_file}" ] || : > "${env_file}"

    ip="$(ip -4 -o addr show scope global 2>/dev/null \
          | awk '{print $4}' | cut -d/ -f1 | grep -v '^127\.' | head -n1 || true)"
    if [ -z "${ip}" ]; then
        ip="$(hostname -I 2>/dev/null | awk '{print $1}' || true)"
    fi
    if p="$(fnmusic_miot_gateway_port)" && [ -n "${p}" ]; then
        port="${p}"
        gw_found=1
    fi

    # 容器版（1.0.0）的 .env 里 MIOT_PORT=8006 是容器内监听端口，与原生版语义不同；
    # 只有识别到这组遗留特征时才强制改端口，其余情况一律尊重用户自定义值。
    if grep -qE '^[[:space:]]*(export[[:space:]]+)?MIOT_DATA_DIR=/data/miot' "${env_file}" 2>/dev/null \
       || grep -qE '^[[:space:]]*(export[[:space:]]+)?FNMUSIC_DB_PATH=/fnmusic-db' "${env_file}" 2>/dev/null; then
        legacy=1
    fi
    ctrl_port="${MIOT_DEFAULT_PORT}"
    console_port="${MIOT_DEFAULT_CONSOLE_PORT}"
    if [ "${legacy}" -eq 0 ]; then
        cur="$(fnmusic_miot_env_get MIOT_PORT)"
        [ -n "${cur}" ] && ctrl_port="${cur}"
        cur="$(fnmusic_miot_env_get FNMUSIC_MIOT_CONSOLE_PORT)"
        [ -n "${cur}" ] && console_port="${cur}"
    fi
    # 即将使用默认端口且被其他程序占用时，自动挑选两个空闲端口，
    # 避免安装因端口冲突直接失败（用户仍会在引导页看到并确认这些端口）。
    if [ "${ctrl_port}" = "${MIOT_DEFAULT_PORT}" ] && [ "${console_port}" = "${MIOT_DEFAULT_CONSOLE_PORT}" ]; then
        local resolved
        resolved="$(fnmusic_miot_pick_if_occupied)"
        if [ -n "${resolved}" ]; then
            ctrl_port="${resolved%% *}"
            console_port="${resolved##* }"
        fi
    fi
    if ! fnmusic_miot_valid_port "${ctrl_port}" || ! fnmusic_miot_valid_port "${console_port}" \
       || [ "${ctrl_port}" = "${console_port}" ]; then
        fnmusic_miot_fail "端口配置无效：MIOT_PORT=${ctrl_port}、FNMUSIC_MIOT_CONSOLE_PORT=${console_port}（须为 1024~65535 且互不相同），请修改 ${env_file}"
    fi

    node_bin="$(fnmusic_miot_find_node)"
    [ -n "${node_bin}" ] || node_bin="/usr/bin/node"

    # 端口键仍用覆盖写，但值来自上面解析出的实际端口（含用户自定义），
    # 保证 MIOT_PORT / MIOT_PUBLIC_PORT / MIOT_UPSTREAM_PORT 三者始终一致。
    _miot_env_set FNMUSIC_MIOT_APPDIR "${MIOT_APPDIR}"
    _miot_env_set FNMUSIC_MIOT_NODE_BIN "${node_bin}"
    _miot_env_set FNMUSIC_MIOT_DATA_ROOT "${MIOT_DATA_ROOT}"
    _miot_env_set MIOT_HOST "0.0.0.0"
    _miot_env_set MIOT_PORT "${ctrl_port}"
    _miot_env_set MIOT_PUBLIC_PORT "${ctrl_port}"
    _miot_env_set MIOT_DATA_DIR "${MIOT_DATA_ROOT}/miot"
    _miot_env_set MIOT_ENV_FILE "${env_file}"
    _miot_env_set MIOT_TOKEN_FILE "${MIOT_DATA_ROOT}/miot/token"
    _miot_env_set MIOT_UPSTREAM_HOST "127.0.0.1"
    _miot_env_set MIOT_UPSTREAM_PORT "${ctrl_port}"
    _miot_env_set FNMUSIC_MIOT_CONSOLE_PORT "${console_port}"
    _miot_env_set FNMUSIC_MIOT_SOCKET "${MIOT_SOCKET}"
    _miot_env_set FNMUSIC_DB_PATH "/usr/local/apps/@appdata/trim.music/db/music.db"
    # 容器版把网关 token 写进了 .env；原生版的 token 只存在 MIOT_TOKEN_FILE 里。
    _miot_env_del MIOT_TOKEN

    # 只补缺失：这些键与部署形态无关，用户可能手工改过。
    _miot_env_add MIOT_REQUIRE_AUTH true
    _miot_env_add MIOT_SERVER_HOST_FORCE false
    _miot_env_add FNMUSIC_MUSIC_DB_DIR "/usr/local/apps/@appdata/trim.music/db"

    # 网关端口 / 基址不再依赖 LAN IP 是否探测成功（回环基址本来就不需要 IP），
    # 也不再把 6688 当唯一答案：conf 解析成功时对齐端口，并纠正脚本自动生成
    # 但已过时的旧基址（例如用户把网关从 6688 改成任意其他端口后升级）。
    # 用户手填的域名 / 反向代理 / 带路径地址一律保留；即便这里判断不了，
    # 运行时 host/gateway.mjs 也会在探测失败时自动发现正确端口。
    local want_base="http://127.0.0.1:${port}" cur_base=""
    cur_base="$(fnmusic_miot_env_get FNMUSIC_BASE_URL)"
    # 开启「强制 HTTPS」的 NAS：运行时会把 301 目标固化成 https://127.0.0.1:<httpsPort>
    # 并写回 .env。升级时保留这个结果，不要覆盖回 http，否则每次重装都要重新发现；
    # FNMUSIC_GATEWAY_PORT 也同步到 HTTPS 端口，供诊断与首启猜测使用。
    local is_auto=0
    if [ -z "${cur_base}" ] || fnmusic_miot_is_auto_base "${cur_base}" "${ip}"; then is_auto=1; fi
    local https_port=""
    if [ "${is_auto}" -eq 1 ]; then
        case "${cur_base}" in
            https://*:*) https_port="${cur_base##*:}" ;;
        esac
        case "${https_port}" in
            ''|*[!0-9]*) https_port="" ;;
        esac
    fi
    if [ -n "${https_port}" ]; then
        _miot_env_set FNMUSIC_GATEWAY_PORT "${https_port}"
    elif [ "${gw_found}" -eq 1 ]; then
        _miot_env_set FNMUSIC_GATEWAY_PORT "${port}"
    else
        _miot_env_add FNMUSIC_GATEWAY_PORT "${port}"
    fi
    if [ "${is_auto}" -eq 1 ]; then
        if [ -n "${https_port}" ]; then
            echo "[fnmusic-miot] 保留运行时固化的 HTTPS 网关基址: ${cur_base}" >> "${FNMUSIC_MIOT_LOG}" 2>&1
        else
            if [ -n "${cur_base}" ] && [ "${cur_base}" != "${want_base}" ]; then
                echo "[fnmusic-miot] 网关基址已纠正: ${cur_base} -> ${want_base} (conf=${port})" >> "${FNMUSIC_MIOT_LOG}" 2>&1
            fi
            _miot_env_set FNMUSIC_BASE_URL "${want_base}"
        fi
    else
        echo "[fnmusic-miot] 保留用户自定义网关基址: ${cur_base}" >> "${FNMUSIC_MIOT_LOG}" 2>&1
    fi

    if [ -n "${ip}" ]; then
        _miot_env_add FNMUSIC_NAS_IP "${ip}"
        # MIOT_SERVER_HOST 是音箱回访用的地址，必须保持可路由的 LAN IP。
        # 自动生成形式 http://<LAN IP>:<端口> 在端口变更后自动跟随；
        # 用户手填的域名 / 反向代理地址原样保留。
        cur="$(fnmusic_miot_env_get MIOT_SERVER_HOST)"
        if [ -z "${cur}" ] || [ "${legacy}" -eq 1 ]; then
            _miot_env_set MIOT_SERVER_HOST "http://${ip}:${ctrl_port}"
        elif printf '%s\n' "${cur}" | grep -qE "^https?://${ip//./\\.}:[0-9]+/?$"; then
            _miot_env_set MIOT_SERVER_HOST "http://${ip}:${ctrl_port}"
        fi
    fi

    mkdir -p "${MIOT_DATA_ROOT}/miot" "${MIOT_LOG_DIR}" 2>/dev/null || true
    echo "[fnmusic-miot] 环境键已对齐 (ip=${ip:-未探测}, gateway=${port}/$( [ "${gw_found}" -eq 1 ] && echo conf || echo default ), control=${ctrl_port}, console=${console_port}, node=${node_bin})" >> "${FNMUSIC_MIOT_LOG}" 2>&1
}

# ------------------------------------------------------------------------------
# 容器版（1.0.0）数据迁移：旧数据在 <appdir>/repo/miot-data，升级会随 repo 一起消失。
# 幂等：新位置已有 token 就直接返回。upgrade_init（删旧文件前）与
# upgrade_callback（新文件就位后）各调一次，任一阶段命中即可。
# ------------------------------------------------------------------------------
fnmusic_miot_migrate_legacy_data() {
    local cand dst="${MIOT_DATA_ROOT}/miot"

    [ -f "${dst}/token" ] && return 0

    for cand in \
        "${TRIM_APPDEST:-}/repo/miot-data" \
        "/vol1/@appcenter/fnmusic-miot/repo/miot-data" \
        "${MIOT_APPDIR}/repo/miot-data"; do
        [ -n "${cand}" ] && [ -d "${cand}/miot" ] || continue
        [ -f "${cand}/miot/token" ] || continue
        mkdir -p "${dst}" "${MIOT_LOG_DIR}" 2>/dev/null || true
        cp -a "${cand}/miot/." "${dst}/" 2>> "${FNMUSIC_MIOT_LOG}" || true
        [ -d "${cand}/logs" ] && cp -a "${cand}/logs/." "${MIOT_LOG_DIR}/" 2>> "${FNMUSIC_MIOT_LOG}" || true
        echo "[fnmusic-miot] 已迁移容器版数据 ${cand} -> ${MIOT_DATA_ROOT}" >> "${FNMUSIC_MIOT_LOG}"
        return 0
    done
    return 0
}
